{
  "name": "el-mall-vivo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node -e \"const f=require('fs');process.exit(['mall_blockout.glb','ao.png','props.json','nav.json'].every((n)=>f.existsSync('public/models/'+n))?0:1)\" || npm run assets --silent",
    "dev": "next dev",
    "prebuild": "npm run assets --silent",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "blockout": "node scripts/build-blockout.mts",
    "test:walk": "npm run assets --silent && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-walk.mts",
    "test:shadow": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-shadow.mts",
    "test:noise": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-noise.mts",
    "test:guard": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-guard.mts",
    "test:fail": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-fail.mts",
    "test:hiding": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-hiding.mts",
    "test:save": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-save.mts",
    "test:stamina": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-stamina.mts",
    "test:sanity": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-sanity.mts",
    "shots": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/shots.mts",
    "pieces": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/piece-shots.mts",
    "props": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-props.mts",
    "nav": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-nav.mts",
    "assets": "npm run blockout --silent && npm run props --silent && npm run nav --silent"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.187.0",
    "three-mesh-bvh": "^0.9.18"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "meshoptimizer": "^1.3.0",
    "typescript": "^5"
  }
}
