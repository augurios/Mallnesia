// One-off import of the security office furniture from Poly Haven (CC0, https://polyhaven.com). The output files in
// public/models/security/ are committed (not generated by `npm run assets`); run this again only to change them:
//
//   node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/security/import.mts
//
// Each model is fetched as the 1k glTF, its textures are shrunk, and a far version is added beside the near one: every
// mesh node gets a simplified copy named "<name>_far" (the convention of src/engine/props.ts). Geometry is
// meshopt-compressed, so the runtime loader needs the meshopt decoder (it already has it).
//
// Sources (all CC0): see the table in docs/art_style_reference.md.

import { mkdtempSync, mkdirSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";
import { Document, NodeIO } from "@gltf-transform/core";
import { ALL_EXTENSIONS, EXTMeshoptCompression } from "@gltf-transform/extensions";
import { dedup, mergeDocuments, prune, simplify, textureCompress, unpartition, weld } from "@gltf-transform/functions";
import { MeshoptEncoder, MeshoptSimplifier } from "meshoptimizer";
import sharp from "sharp";

const OUT = "public/models/security";
const MODELS: { id: string; out: string; texture: number; farRatio: number }[] = [
  { id: "metal_office_desk", out: "desk", texture: 1024, farRatio: 0.15 },
  { id: "television_02", out: "crt", texture: 512, farRatio: 0.2 },
  { id: "plastic_monobloc_chair_01", out: "chair", texture: 512, farRatio: 0.15 },
];

await MeshoptEncoder.ready;
await MeshoptSimplifier.ready;
const io = new NodeIO().registerExtensions(ALL_EXTENSIONS).registerDependencies({ "meshopt.encoder": MeshoptEncoder });

async function fetchTo(url: string, path: string) {
  const res = await fetch(url);
  if (!res.ok) throw new Error(`${url}: ${res.status}`);
  mkdirSync(join(path, ".."), { recursive: true });
  writeFileSync(path, Buffer.from(await res.arrayBuffer()));
}

/** Downloads the 1k glTF and its files into a fresh folder of its own; returns the .gltf path. */
async function download(id: string): Promise<string> {
  const files = await (await fetch(`https://api.polyhaven.com/files/${id}`)).json();
  const gltf = files.gltf["1k"].gltf;
  const dir = mkdtempSync(join(tmpdir(), `ph-${id}-`));
  const main = join(dir, `${id}.gltf`);
  await fetchTo(gltf.url, main);
  for (const [rel, f] of Object.entries(gltf.include as Record<string, { url: string }>)) await fetchTo(f.url, join(dir, rel));
  return main;
}

async function load(path: string, texture: number): Promise<Document> {
  const doc = await io.read(path);
  await doc.transform(dedup(), weld(), textureCompress({ encoder: sharp, targetFormat: "jpeg", resize: [texture, texture] }));
  return doc;
}

for (const m of MODELS) {
  const path = await download(m.id);
  const doc = await load(path, m.texture);
  // the far version: the same file simplified, merged in, its nodes renamed and set beside the near ones
  const far = await load(path, 64);
  await far.transform(simplify({ simplifier: MeshoptSimplifier, ratio: m.farRatio, error: 0.01 }));
  const scene = doc.getRoot().getDefaultScene() ?? doc.getRoot().listScenes()[0];
  const farNodes = new Set(far.getRoot().listNodes());
  const map = mergeDocuments(doc, far);
  for (const node of farNodes) {
    const merged = map.get(node) as ReturnType<Document["createNode"]>;
    if (!merged.getParentNode()) scene.addChild(merged);
    merged.setName(`${node.getName()}_far`);
  }
  // the far copy keeps its own tiny textures and materials: give it the near materials instead (only the geometry differs)
  const nearMeshes = doc.getRoot().listMeshes().filter((x) => !x.getName().endsWith("_far"));
  for (const node of farNodes) {
    const merged = map.get(node) as ReturnType<Document["createNode"]>;
    const mesh = merged.getMesh();
    const near = nearMeshes.find((n) => n.getName() === node.getMesh()?.getName());
    if (!mesh || !near) continue;
    mesh.setName(`${near.getName()}_far`);
    mesh.listPrimitives().forEach((p, k) => p.setMaterial(near.listPrimitives()[k]?.getMaterial() ?? p.getMaterial()));
  }
  for (const s of doc.getRoot().listScenes()) if (s !== scene) s.dispose();
  await doc.transform(prune(), dedup(), unpartition());
  doc.createExtension(EXTMeshoptCompression).setRequired(true).setEncoderOptions({ method: EXTMeshoptCompression.EncoderMethod.FILTER });
  mkdirSync(OUT, { recursive: true });
  const bytes = await io.writeBinary(doc);
  writeFileSync(`${OUT}/${m.out}.glb`, bytes);
  const tris = (far2: boolean) =>
    doc
      .getRoot()
      .listMeshes()
      .filter((x) => x.getName().endsWith("_far") === far2)
      .reduce((a, x) => a + x.listPrimitives().reduce((b, p) => b + (p.getIndices()?.getCount() ?? 0) / 3, 0), 0);
  console.log(`${m.id} -> ${OUT}/${m.out}.glb  ${(bytes.byteLength / 1024).toFixed(0)} KB  near ${tris(false)} tris, far ${tris(true)} tris`);
}
