# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# screenshots from npm run shots
/shots/

# generated by npm run assets from docs/floorplans and scripts/kit (rebuilt by predev and prebuild)
/public/models/mall_blockout.glb
/public/models/ao.png
/public/models/props.json
/public/models/nav.json
/public/models/kit/
/backrooms-main
# Python bytecode (Blender writes it next to the build scripts it imports)
__pycache__/
